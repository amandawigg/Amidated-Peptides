# 8. Replicate count heat map (Fig. 1e)

Detection confidence expressed as the **number of biological replicates (0–3)
in which MS/MS spectral identity was confirmed**, per peptide per tissue. This
avoids quantitative assumptions while communicating detection reproducibility.

```{r replicate_count_heatmap, fig.width=10, fig.height=14}
tissue_order <- c("BAT", "Brain", "Ileum", "Heart", "Kidney", "Liver",
                  "Lung", "Pancreas", "Quad", "Spleen", "iWAT", "plasma")

# Peptide labels. Taken from the curated name table rather than derived from the
# protein string: derivation drops the positional suffixes (PEP-BMP2 vs
# PEP-BMP2-2) and mislabels the known hormones (Neurokinin A, TRH, GnRH1).
pep_labels <- read_excel(file.path(DATA_DIR, "Supplemental_Table_2.xlsx"),
                         sheet = "spectral valid", skip = 1) %>%
  distinct(Peptide, pep_name)

replicate_counts <- results %>%
  filter(!grepl("Std", Replicate, ignore.case = TRUE),
         Peptide %in% final_panel$Peptide) %>%
  mutate(tissue = gsub("_.*", "", Replicate)) %>%
  filter(tissue %in% tissue_order) %>%
  left_join(pep_labels, by = "Peptide") %>%
  group_by(pep_name, tissue) %>%
  summarise(n_detected = sum(is_real_detection, na.rm = TRUE), .groups = "drop") %>%
  complete(pep_name = unique(pep_name), tissue = tissue_order,
           fill = list(n_detected = 0)) %>%
  mutate(tissue = factor(tissue, levels = tissue_order))

rc_wide <- replicate_counts %>%
  pivot_wider(names_from = tissue, values_from = n_detected, values_fill = 0) %>%
  as.data.frame()
rownames(rc_wide) <- rc_wide$pep_name
rc_wide$pep_name  <- NULL
rc_wide   <- rc_wide[, tissue_order[tissue_order %in% colnames(rc_wide)]]
rc_matrix <- data.matrix(rc_wide)

# Guard against silent drift in the inputs
stopifnot(nrow(rc_matrix) == 62, ncol(rc_matrix) == 12, sum(rc_matrix) == 786)

det_colors <- c(
  "grey94",                                                                  # 0
  rgb(0.1699716714 * 0.4 + 0.6, 0.3342776204 * 0.4 + 0.6, 0.4957507082 * 0.4 + 0.6),  # 1
  rgb(0.1699716714 * 0.7 + 0.3, 0.3342776204 * 0.7 + 0.3, 0.4957507082 * 0.7 + 0.3),  # 2
  rgb(0.1699716714,             0.3342776204,             0.4957507082)      # 3
)

pdf(file.path(OUT_DIR, "Fig1e_detection_heatmap.pdf"), width = 10, height = 14)
heatmap.2(
  rc_matrix,
  col = det_colors, breaks = c(-0.5, 0.5, 1.5, 2.5, 3.5),
  trace = "none", density.info = "none", scale = "none",
  Rowv = TRUE, Colv = TRUE, dendrogram = "both",
  margins = c(6, 8), cexRow = 0.25, cexCol = 0.6,
  key = TRUE, key.title = "Replicates\nDetected",
  key.xlab = "0          1          2          3",
  xlab = "", ylab = ""
)
dev.off()
```

