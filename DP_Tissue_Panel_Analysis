# 8. Detection summary

```{r summary}
per_peptide <- detected %>% count(peptide, name = "n_detections")
per_tissue  <- detected %>% count(tissue,  name = "n_detections") %>%
  arrange(desc(n_detections))

cat("detections per peptide — median:", median(per_peptide$n_detections),
    " range:", min(per_peptide$n_detections), "-",
    max(per_peptide$n_detections), "\n\n")
print(as.data.frame(per_tissue))
```

