# 9. Overlap with previous datasets

```{r overlap}
prev_detected <- read.csv(PATH_PREV_DET)
predicted     <- read.csv(PATH_PREDICTED)

df_detection_list <- final_panel %>%
  mutate(Previously_Detected = Peptide %in% prev_detected$sequence)

df_predicted <- predicted %>%
  mutate(Detected = peptide.sequence %in% final_panel$Peptide)

cat("Previously detected:", sum(df_detection_list$Previously_Detected),
    "of", nrow(df_detection_list),
    "| newly detected:", sum(!df_detection_list$Previously_Detected), "\n")
```

