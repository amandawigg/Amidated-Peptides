# 7. Replicate count heat map (Fig. 1e)

Detection confidence expressed as the **number of biological replicates (0–3)
in which MS/MS spectral identity was confirmed**, per peptide per tissue. This
avoids quantitative assumptions while communicating detection reproducibility.

```{r heatmap, fig.width=10, fig.height=14}
replicate_counts <- results %>%
  filter(peptide %in% detected$peptide, tissue %in% TISSUE_ORDER) %>%
  group_by(peptide, tissue) %>%
  summarise(n_detected = sum(is_real_detection), .groups = "drop") %>%
  complete(peptide = unique(peptide), tissue = TISSUE_ORDER,
           fill = list(n_detected = 0)) %>%
  mutate(tissue = factor(tissue, levels = TISSUE_ORDER))

rc_wide <- replicate_counts %>%
  pivot_wider(names_from = tissue, values_from = n_detected, values_fill = 0) %>%
  as.data.frame()
rownames(rc_wide) <- rc_wide$peptide
rc_wide$peptide   <- NULL
rc_wide   <- rc_wide[, TISSUE_ORDER[TISSUE_ORDER %in% colnames(rc_wide)]]
rc_matrix <- data.matrix(rc_wide)

stopifnot(nrow(rc_matrix) == 62, ncol(rc_matrix) == 12, sum(rc_matrix) == 787)

det_colors <- c(
  "grey94",                                                                          # 0
  rgb(0.1699716714 * 0.4 + 0.6, 0.3342776204 * 0.4 + 0.6, 0.4957507082 * 0.4 + 0.6), # 1
  rgb(0.1699716714 * 0.7 + 0.3, 0.3342776204 * 0.7 + 0.3, 0.4957507082 * 0.7 + 0.3), # 2
  rgb(0.1699716714,             0.3342776204,             0.4957507082)              # 3
)

pdf(file.path(OUT_DIR, "Fig1e_detection_heatmap.pdf"), width = 10, height = 14)
heatmap.2(
  rc_matrix,
  col = det_colors, breaks = c(-0.5, 0.5, 1.5, 2.5, 3.5),
  trace = "none", density.info = "none", scale = "none",
  Rowv = TRUE, Colv = TRUE, dendrogram = "both",
  margins = c(6, 8), cexRow = 0.25, cexCol = 0.6,
  key = TRUE, key.title = "Replicates\nDetected",
  key.xlab = "0          1          2          3",
  xlab = "", ylab = ""
)
dev.off()
```

